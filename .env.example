# Realm usado pelos aliases legados /api/leaderboard e /ws/game.
DEFAULT_REALM_ID=regtest
GAME_MODE=mempool

# Autenticação Redis (obrigatório). Use uma senha forte e aleatória.
REDIS_PASSWORD=troque-por-uma-senha-redis-forte-e-aleatoria

# Compatibilidade com instalações anteriores. As variáveis específicas abaixo
# prevalecem e devem receber valores exclusivos por nó.
RPC_USER=mempool_legacy
RPC_PASSWORD=troque-o-fallback-legado
REGTEST_RPC_USER=mempool_regtest
REGTEST_RPC_PASSWORD=troque-por-uma-senha-regtest-longa-e-aleatoria
SIGNET_RPC_USER=mempool_signet
SIGNET_RPC_PASSWORD=troque-por-uma-senha-signet-longa-e-aleatoria
MAINNET_RPC_USER=mempool_mainnet
MAINNET_RPC_PASSWORD=troque-por-uma-senha-mainnet-longa-e-aleatoria
# Hosts e portas RPC/ZMQ são definidos por serviço no Compose.

# Pruning (MiB). Regtest não é podada; Signet e Mainnet usam volumes próprios.
SIGNET_PRUNE_MIB=2048
MAINNET_PRUNE_MIB=10240
MAINNET_DBCACHE_MIB=450

# Aplicação
BACKEND_IMAGE=mempool-miner-backend:local
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
# Swagger/OpenAPI bruto permanece desligado e não é encaminhado pelo Nginx.
ENABLE_API_DOCS=false
HIGH_FEE_RATE_SAT_VB=20
TX_QUEUE_MAX_SIZE=5000
TX_PROCESS_INTERVAL_SECONDS=1.0
LOG_LEVEL=INFO
