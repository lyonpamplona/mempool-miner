# Rede: regtest, signet ou main. Ajuste RPC_PORT junto com a rede.
BITCOIN_NETWORK=regtest
GAME_MODE=mempool

# Gere valores exclusivos antes de iniciar a stack.
RPC_USER=mempool_app
RPC_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
RPC_HOST=bitcoind
RPC_PORT=18443
ZMQ_HOST=bitcoind
ZMQ_PORT=28332

# Aplicação
CORS_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
HIGH_FEE_RATE_SAT_VB=20
TX_QUEUE_MAX_SIZE=5000
TX_PROCESS_INTERVAL_SECONDS=1.0
LOG_LEVEL=INFO
